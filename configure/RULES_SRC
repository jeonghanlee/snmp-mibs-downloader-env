#
.DEFAULT_GOAL := help

.PHONY: help default

# # help is defined in 
# # https://gist.github.com/rcmachado/af3db315e31383502660
help:
	$(info --------------------------------------- )	
	$(info Make Targets)
	$(info --------------------------------------- )
	$(QUIET) awk '/^[a-zA-Z\-\_0-9]+:/ {            \
	  nb = sub( /^## /, "", helpMsg );              \
	  if(nb == 0) {                                 \
	    helpMsg = $$0;                              \
	    nb = sub( /^[^:]*:.* ## /, "", helpMsg );   \
	  }                                             \
	  if (nb)                                       \
	    print  $$1 "\t" helpMsg;                    \
	}                                               \
	{ helpMsg = $$0 }'                              \
	$(MAKEFILE_LIST) | column -ts:


default: help

.PHONY: init clone update deinit distclean

## Clone Source
init: clone 
	$(QUIET) $(MAKE) mibs.update

# gitclone use '-C' option, so git version should be more than 1.8.5. CentOS7 git is imcompatiable.
#
clone:
	$(call gitclone,$(SRC_GITURL),$(SRC_PATH),$(SRC_TAG))


## Clean Source
distclean:
	$(call distclean, $(SRC_PATH))

deinit: distclean

get:
	$(SUDO) download-mibs --get

list:
	$(SUDO) download-mibs --list

.PHONY: get list

## Update IETF and IANA MIB sources from official registries
mibs.update:
	$(QUIET) $(PYTHON) tools/update-mibs.py update $(MIB_UPDATE_ARGS)

## Verify local MIB source checksums
mibs.check:
	$(QUIET) $(PYTHON) tools/update-mibs.py check $(MIB_UPDATE_ARGS)

## Verify every generated MIB against the selected source data
mibs.installed.check:
	$(QUIET) $(PYTHON) tools/update-mibs.py installed $(MIB_UPDATE_ARGS)

.PHONY: mibs.update mibs.check mibs.installed.check
